// The main window: top bar, account sidebar and the merged calendar views.
//
// Rules carried over from the M0 spikes: list models are patched row by row from Rust
// (never replaced), and geometry is computed here from a few shared lengths.

import { Palette } from "std-widgets.slint";

export struct TimedItem {
    // Index for looking up the event's details when it is clicked.
    instance: int,
    title: string,
    time: string,
    day: int,
    start-min: int,
    end-min: int,
    // Position among overlapping events: column `col` of `cols`.
    col: int,
    cols: int,
    // Whether it can be dragged to another time, and by its lower edge to another length.
    movable: bool,
    resizable: bool,
    color: color,
    text-color: color,
}

export struct AllDayItem {
    instance: int,
    title: string,
    first-day: int,
    last-day: int,
    row: int,
    // Whether it can be dragged to other days.
    movable: bool,
    color: color,
    text-color: color,
}

// One guest of an event.
export struct Guest {
    name: string,
    // 0 has not answered, 1 yes, 2 no, 3 maybe.
    status: int,
    organizer: bool,
    optional: bool,
}

export struct EventDetail {
    title: string,
    when: string,
    // The event's own time zone, when it is not the one the times are shown in.
    zone: string,
    location: string,
    description: string,
    calendar: string,
    account: string,
    color: color,
    // Address of the event in Google's web interface; empty if unknown.
    link: string,
    // Whether the app can delete it itself.
    can-delete: bool,
    // Whether it can be changed in the editor.
    can-edit: bool,
    // One occurrence of a series: deleting asks how much of the series.
    repeating: bool,
    // The account invited guests, who can be told about a deletion.
    notify-guests: bool,
    // Who is invited, and the address of the video meeting, if any.
    guests: [Guest],
    meet: string,
    // This account's own answer to the invitation: 0 none yet, 1 yes, 2 no, 3 maybe;
    // -1 when it is not invited (or cannot answer here).
    rsvp: int,
}

// A day of the month view.
export struct MonthCell {
    // The day's number; the first of a month also names the month.
    label: string,
    today: bool,
    // Belongs to the month before or after the one shown.
    dim: bool,
    // How many events did not fit.
    more: int,
}

// One line of the month view: a bar across days, or an event within one day.
export struct MonthChip {
    instance: int,
    title: string,
    // Start time, for events within a day.
    time: string,
    week: int,
    first-day: int,
    last-day: int,
    row: int,
    // Drawn as a bar in the event's colour rather than as plain text.
    filled: bool,
    color: color,
    text-color: color,
}

// One line of the schedule view: an event on one of the days it touches.
export struct ScheduleRow {
    instance: int,
    // The first line of its day carries the date.
    first-of-day: bool,
    day-number: string,
    day-name: string,
    today: bool,
    time: string,
    title: string,
    color: color,
}

// A day of the sidebar's small month.
export struct MiniDay {
    label: string,
    today: bool,
    // Belongs to the month before or after.
    dim: bool,
    // Among the days the main view is showing.
    shown: bool,
}

// A calendar a new event can be put in.
export struct DraftCalendar {
    name: string,
    account: string,
    color: color,
}

// The editor's fields. Dates are typed as 2026-11-17 and times as 9:30; the choices
// are positions in the lists the editor shows.
export struct EditorForm {
    title: string,
    all-day: bool,
    start-date: string,
    end-date: string,
    start-time: string,
    end-time: string,
    repeat: int,
    location: string,
    description: string,
    // 0 is the calendar's colour.
    color: int,
    reminder: int,
    visibility: int,
    busy: bool,
}

export struct DayHeader {
    weekday: string,
    number: string,
    today: bool,
}

// The sidebar is one flat list: an account row followed by that account's calendars.
export struct SidebarRow {
    account-id: int,
    // Empty on account rows.
    calendar-id: string,
    is-account: bool,
    text: string,
    email: string,
    color: color,
    shown: bool,
}

export enum StatusKind {
    idle,
    waiting-for-browser,
    syncing,
    saving,
    failed,
}

// Colours in one place, each in a light and a dark version.
global Theme {
    // The user's choice: 0 follows the desktop's light or dark setting, 1 is always
    // light, 2 always dark.
    in-out property <int> mode;
    out property <bool> dark: mode == 2 || (mode == 0 && Palette.color-scheme == ColorScheme.dark);
    out property <color> surface: dark ? #1f1f1f : #ffffff;
    // Cards floating above the surface.
    out property <color> card: dark ? #2d2e30 : #ffffff;
    out property <color> line: dark ? #444746 : #dadce0;
    out property <color> text: dark ? #e3e3e3 : #3c4043;
    out property <color> text-dim: dark ? #9aa0a6 : #70757a;
    out property <color> hover: dark ? #303134 : #f1f3f4;
    out property <color> pressed: dark ? #3c4043 : #e8eaed;
    out property <color> selected: dark ? #004a77 : #d2e3fc;
    out property <color> accent: dark ? #8ab4f8 : #1a73e8;
    // Text on the accent colour (today's number).
    out property <color> on-accent: dark ? #062e6f : #ffffff;
    out property <color> now: dark ? #f28b82 : #ea4335;
    out property <color> danger: dark ? #f28b82 : #d93025;
}

component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> outlined;
    // The one thing to do next: in the accent colour.
    in property <bool> filled;
    in property <color> text-color: filled ? Theme.on-accent : Theme.text;
    callback clicked;

    height: 36px;
    width: label.preferred-width + 28px;
    border-radius: self.height / 2;
    border-width: outlined ? 1px : 0px;
    border-color: Theme.line;
    background: filled ? Theme.accent : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    opacity: filled && touch.has-hover ? 0.9 : 1;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    label := Text {
        text: root.text;
        font-size: 14px;
        font-weight: 500;
        color: root.text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A box to type in, with a hint while it is empty.
component Field inherits Rectangle {
    in property <string> hint;
    in property <string> value;
    in property <bool> multiline;
    in property <length> text-size: 14px;
    in property <bool> take-focus;
    callback edited(string);
    // Enter in a one-line box.
    callback accepted(string);

    height: multiline ? 96px : 36px;
    border-radius: 4px;
    background: Theme.hover;
    clip: true;

    if input.text == "": Text {
        x: 10px;
        y: root.multiline ? 8px : 0px;
        height: root.multiline ? 20px : parent.height;
        text: root.hint;
        font-size: root.text-size;
        color: Theme.text-dim;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 10px;
        y: root.multiline ? 8px : 0px;
        width: parent.width - 20px;
        height: parent.height - 2 * self.y;
        text: root.value;
        font-size: root.text-size;
        color: Theme.text;
        single-line: !root.multiline;
        wrap: root.multiline ? word-wrap : no-wrap;
        vertical-alignment: root.multiline ? top : center;
        accessible-label: root.hint;
        init => {
            if (root.take-focus) {
                self.focus();
                // Typing goes on after what is there already.
                self.set-selection-offsets(self.text.character-count, self.text.character-count);
            }
        }
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted(self.text);
        }
    }
}

// One of several choices, shown as a line that opens into the list of them.
component Choice inherits VerticalLayout {
    in property <[string]> options;
    in property <int> current;
    callback chosen(int);
    property <bool> open;

    Rectangle {
        height: 36px;
        border-radius: 4px;
        background: head-touch.has-hover ? Theme.pressed : Theme.hover;
        accessible-role: combobox;
        accessible-label: head.text;
        accessible-action-default => {
            root.open = !root.open;
        }

        head-touch := TouchArea {
            clicked => {
                root.open = !root.open;
            }
        }

        head := Text {
            x: 10px;
            width: parent.width - 36px;
            height: parent.height;
            text: root.options[root.current];
            font-size: 14px;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: parent.width - 24px;
            height: parent.height;
            text: root.open ? "▴" : "▾";
            font-size: 12px;
            color: Theme.text-dim;
            vertical-alignment: center;
        }
    }

    if root.open: VerticalLayout {
        for option[i] in root.options: Rectangle {
            height: 30px;
            border-radius: 4px;
            background: i == root.current ? Theme.selected : option-touch.has-hover ? Theme.hover : transparent;
            accessible-role: list-item;
            accessible-label: option;
            accessible-action-default => {
                root.chosen(i);
                root.open = false;
            }

            option-touch := TouchArea {
                clicked => {
                    root.chosen(i);
                    root.open = false;
                }
            }

            Text {
                x: 22px;
                width: parent.width - 30px;
                height: parent.height;
                text: option;
                font-size: 13px;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// A tick box with its text.
component CheckRow inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback toggled;

    height: 36px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggled();
    }

    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }

    Rectangle {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 3px;
        border-width: 2px;
        border-color: root.checked ? Theme.accent : Theme.text-dim;
        background: root.checked ? Theme.accent : transparent;
    }

    Text {
        x: 40px;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        color: Theme.text;
        vertical-alignment: center;
    }
}

// A line of the editor: what it is about, then the control.
component EditorRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;

    Text {
        width: 96px;
        height: 36px;
        text: root.label;
        font-size: 13px;
        color: Theme.text-dim;
        vertical-alignment: center;
    }

    @children
}

// One choice of several, with a radio button in front.
component RadioRow inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 36px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: 2px;
        border-color: root.selected ? Theme.accent : Theme.text-dim;

        if root.selected: Rectangle {
            x: 4px;
            y: 4px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Theme.accent;
        }
    }

    Text {
        x: 40px;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        color: Theme.text;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "gcal-client";
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 720px;
    min-height: 420px;
    background: Theme.surface;
    forward-focus: keys;

    in property <string> period-title;
    in property <StatusKind> status-kind: StatusKind.idle;
    in property <string> status-detail;
    in property <[DayHeader]> days;
    // Number of day columns: 1, 4 or 7.
    in property <int> day-count: 7;
    // Which entry of the view switcher is active: 0 day, 1 week, 2 month, 3 four days,
    // 4 schedule.
    in property <int> view-index: 1;
    property <bool> is-month: root.view-index == 2;
    property <bool> is-schedule: root.view-index == 4;
    property <bool> is-year: root.view-index == 5;
    // The views in the order of their numbers, and the key of each. The fourth has as
    // many days as the settings say.
    in property <int> custom-days: 4;
    property <[string]> view-labels: [@tr("Day"), @tr("Week"), @tr("Month"), @tr("{} days", root.custom-days), @tr("Schedule"), @tr("Year")];
    property <[string]> view-keys: ["D", "W", "M", "X", "A", "Y"];
    property <bool> view-menu-visible;
    property <length> view-menu-x;
    in-out property <int> custom-days-choice: 2;
    callback custom-days-chosen(int);
    // All events of one day of the month view, behind its "N more": Rust fills the
    // list for the cell asked for and shows it where the click was.
    callback day-list-requested(int);
    in property <[ScheduleRow]> day-list;
    in property <string> day-list-title;
    in-out property <bool> day-list-visible;
    property <length> day-list-x;
    property <length> day-list-y;
    function ask-day-list(cell: int, x: length, y: length) {
        day-list-x = x;
        day-list-y = y;
        root.day-list-requested(cell);
    }
    // The year: twelve months' names and their days, 42 for each month.
    in property <[string]> year-months;
    in property <[MiniDay]> year-days;
    callback year-pick(int);
    in property <[ScheduleRow]> schedule;
    // The sidebar's small month: 42 days, paged on its own, picks the day to show.
    in property <string> mini-title;
    in property <[MiniDay]> mini-days;
    callback mini-step(int);
    callback mini-pick(int);
    // The month view: seven names, one cell per day, one chip per line of an event.
    in property <[string]> weekday-names;
    in property <[MonthCell]> month-cells;
    in property <[MonthChip]> month-chips;
    in property <int> month-weeks: 5;
    // How many lines of events fit in a cell of the month view.
    out property <int> month-capacity: Math.max(1, Math.floor((month-row-h - month-number-h) / bar-h));
    callback month-resized();
    changed month-capacity => {
        root.month-resized();
    }
    // A cell of the month view was chosen: show that day.
    callback open-day(int);
    in property <[TimedItem]> timed;
    in property <[AllDayItem]> all-day;
    in property <int> all-day-rows;
    in property <[SidebarRow]> sidebar;
    // Position of the current-time line; `now-day` is -1 when today is not in view.
    in property <int> now-day: -1;
    in property <int> now-min;
    // The account whose removal is waiting for confirmation, if any.
    in-out property <string> confirm-remove;

    callback go-today();
    callback go-previous();
    callback go-next();
    callback set-view(int);
    callback event-clicked(int);
    callback open-link(string);
    in property <EventDetail> detail;
    in-out property <bool> detail-visible;
    // The list of keyboard shortcuts, opened with "?".
    property <bool> help-visible;
    // The editor: all of an event's fields. Rust fills `editor` and shows it; "Save"
    // hands the form back, with the calendar chosen for a new event.
    in-out property <EditorForm> editor;
    in-out property <bool> editor-visible;
    in property <bool> editor-new;
    // The event repeats, or reminds, in a way the lists do not offer: one more choice
    // keeps that as it is.
    in property <bool> editor-custom-repeat;
    in property <bool> editor-custom-reminder;
    in property <string> editor-calendar-name;
    in property <[string]> editor-calendars;
    // The calendar's colour, then Google's event colours.
    in property <[color]> editor-colors;
    // Why the form cannot be saved as it is.
    in property <string> editor-error;
    callback editor-requested(int);
    callback editor-from-draft(string, int);
    callback editor-save(EditorForm, int);
    changed editor-visible => {
        if (!root.editor-visible) {
            keys.focus();
        }
    }
    // "Go to date", opened with "g": a date is typed, Rust reads it and shows that day,
    // or says why it could not.
    in-out property <bool> goto-visible;
    in property <string> goto-error;
    callback goto-date(string);
    changed goto-visible => {
        if (!root.goto-visible) {
            keys.focus();
        }
    }
    // The settings card, opened with "s" or its button.
    property <bool> settings-visible;
    // The hours' labels beside the day columns, in the clock that was chosen.
    in property <[string]> hour-labels;
    // Choices of the settings card: the week's first day (Monday, Sunday, Saturday)
    // and the clock (24 hours, 12 hours). Rust sets what is remembered and is told of
    // a new choice.
    in-out property <int> week-start-choice;
    in-out property <int> clock-choice;
    callback week-start-chosen(int);
    callback clock-chosen(int);
    // Light or dark: 0 as the desktop, 1 light, 2 dark. Rust sets the remembered choice
    // at start and is told of a new one.
    in-out property <int> theme-mode <=> Theme.mode;
    callback theme-chosen(int);
    // Where the event was clicked; the details open next to it.
    property <length> detail-x;
    property <length> detail-y;

    // Which instance the details card is about.
    property <int> detail-instance;
    // Deletes the event behind an instance: how much of a series (0 this occurrence,
    // 1 this and following, 2 all) and whether to tell the guests. The worker answers
    // with delete-finished, naming the occurrence it removed if it was a single one.
    callback delete-event(int, int, bool);
    callback delete-finished(bool, string);
    // Answers the invitation to the event behind an instance: 1 yes, 2 no, 3 maybe.
    callback rsvp(int, int);
    // An event was dragged: by how many days and minutes; or its lower edge, by how
    // many minutes. The worker answers with change-finished.
    callback event-moved(int, int, int);
    callback event-resized(int, int);
    // Whether it was made, the occurrence it was made to if it was a single one, and
    // the version the event now has.
    callback change-finished(bool, string, string);
    // Counted up by Rust whenever the views are redrawn from the cache. A drag notes it
    // at its start and is dropped if it has changed by its end: the block dragged may
    // then stand for another event.
    in property <int> generation;
    // A repeating event was dragged: the question card asks how much of the series is
    // meant and answers with edit-scope-chosen (0 this, 1 this and following, 2 all).
    property <bool> ask-edit;
    callback edit-scope-chosen(int);
    public function ask-edit-scope() {
        root.detail-visible = false;
        root.delete-scope = 0;
        root.ask-edit = true;
        root.delete-ask-visible = true;
    }

    function confirm-ask() {
        if (root.ask-edit) {
            root.delete-ask-visible = false;
            root.edit-scope-chosen(root.delete-scope);
        } else {
            root.delete-event(root.detail-instance, root.delete-scope, root.delete-notify);
        }
    }
    // Google cannot be reached: the calendar shows what was fetched last and nothing
    // can be changed (no changes are kept for later).
    in property <bool> offline;
    // The questions asked before deleting a repeating event or one with guests.
    in-out property <bool> delete-ask-visible;
    property <int> delete-scope;
    property <bool> delete-notify;

    // Deletes the event of the open details card, asking first where there is a choice.
    function ask-delete() {
        if (root.offline) {
            return;
        }
        if (root.detail.repeating || root.detail.notify-guests) {
            root.delete-scope = 0;
            root.delete-notify = root.detail.notify-guests;
            root.ask-edit = false;
            root.delete-ask-visible = true;
        } else {
            root.delete-event(root.detail-instance, 0, false);
        }
    }
    // A short message about the last change, with "Undo"; empty when there is none.
    in property <string> toast;
    in property <bool> toast-undo;
    // A new event: asked for with a day (counted from the first one shown; negative for
    // "about now"), the minute of the day, and whether it is to last all day. Rust fills
    // in the card's properties and shows it.
    // The last number is its length in minutes, 0 for the usual hour.
    callback draft-requested(int, int, bool, int);
    // Title and the position of the chosen calendar.
    callback draft-save(string, int);
    // The worker's answer to creating an event: whether it exists now, and its
    // identifier and version, which allow taking it back.
    callback event-created(bool, string, string);
    in-out property <bool> draft-visible;
    in property <string> draft-when;
    in property <[DraftCalendar]> draft-calendars;
    in-out property <int> draft-calendar;
    // Where the new event's ghost is drawn in the day columns; day -1 for none.
    in property <int> draft-day: -1;
    in property <int> draft-min;
    in property <int> draft-len: 60;
    // The time being dragged out on empty hours for a new event; day -1 for none.
    property <int> sel-day: -1;
    property <int> sel-from;
    property <int> sel-start;
    property <int> sel-end;

    // Scrolls the hours so that a time of day is on screen, if it is not.
    public function reveal-minute(minute: int) {
        if (minute / 60.0 * hour-h < -grid.content-y || (minute + 60) / 60.0 * hour-h > -grid.content-y + grid.height) {
            grid.content-y = -Math.max(0px, Math.min(hour-h * 24 - grid.height, minute / 60.0 * hour-h - grid.height / 3));
        }
    }

    function ask-draft(day: int, minute: int, all-day: bool, length: int, x: length, y: length) {
        if (root.offline) {
            return;
        }
        detail-x = x;
        detail-y = y;
        root.draft-requested(day, minute, all-day, length);
    }

    function close-draft() {
        root.draft-visible = false;
        keys.focus();
    }
    callback undo();
    // Something the user must read before going on (a change that was refused, say).
    // Shown as a dialog until dismissed; empty when there is none.
    in-out property <string> notice;

    function show-detail(instance: int, x: length, y: length) {
        detail-instance = instance;
        detail-x = x;
        detail-y = y;
        root.event-clicked(instance);
    }
    // Account, calendar, and whether it should now be shown.
    callback toggle-calendar(int, string, bool);
    callback add-account();
    callback remove-account(string);
    callback sync-now();
    // Raised from the background worker when the cache changed.
    callback data-changed();

    // The height of an hour in the day columns: the zoom. Changed with Ctrl and the
    // wheel, Ctrl and + or -, or in the settings; Rust remembers it.
    in-out property <length> hour-h: 48px;
    callback zoom-changed(float);
    property <float> zoom-centre;

    // Sets the height of an hour, keeping the time in the middle of the screen there.
    function set-hour-height(height: length) {
        root.zoom-centre = (grid.height / 2 - grid.content-y) / root.hour-h;
        root.hour-h = Math.max(20px, Math.min(192px, height));
        grid.content-y = -Math.max(0px, Math.min(root.hour-h * 24 - grid.height, root.zoom-centre * root.hour-h - grid.height / 2));
        root.zoom-changed(root.hour-h / 1px);
    }

    // A step from a key or a button: a tenth.
    function zoom-by(steps: int) {
        root.set-hour-height(steps > 0 ? root.hour-h * 1.1 : root.hour-h / 1.1);
    }

    // The wheel or two fingers on a touchpad, with Ctrl: in proportion to how far it
    // was turned. One notch of a wheel is about 60 px, which makes a twelfth.
    function zoom-wheel(delta: length) {
        root.set-hour-height(root.hour-h * (1 + Math.max(-90, Math.min(90, delta / 1px)) * 0.0014));
    }
    // The height of an hour when two fingers began to pinch.
    property <length> pinch-start;
    property <length> gutter: 56px;
    property <length> head-h: 80px;
    property <length> bar-h: 22px;
    property <length> strip-h: Math.max(1, root.all-day-rows) * bar-h + 6px;
    property <length> day-w: (main.width - gutter) / root.day-count;
    property <length> month-names-h: 28px;
    property <length> month-number-h: 30px;
    property <length> month-col-w: main.width / 7;
    property <length> month-row-h: (main.height - month-names-h) / Math.max(1, root.month-weeks);

    public function scroll-to-hour(hour: int) {
        // A little above the hour, so that its label is not cut by the edge.
        grid.content-y = Math.min(0px, -hour * hour-h + 10px);
    }

    keys := FocusScope {
        key-pressed(event) => {
            // What is open on top takes the keys, and nothing behind it does: a key
            // meant for a card must never act on the calendar underneath (Delete with
            // an event's details open behind the settings would delete that event).
            if (root.notice != "") {
                // The dialog is all there is until it is dismissed.
                if (event.text == Key.Escape || event.text == Key.Return) {
                    root.notice = "";
                }
                return accept;
            }
            if (root.delete-ask-visible) {
                // Only its own keys while the question is open.
                if (event.text == Key.Escape) {
                    root.delete-ask-visible = false;
                } else if (event.text == Key.Return) {
                    root.confirm-ask();
                } else if (event.text == Key.DownArrow && (root.ask-edit || root.detail.repeating)) {
                    root.delete-scope = Math.min(2, root.delete-scope + 1);
                } else if (event.text == Key.UpArrow && (root.ask-edit || root.detail.repeating)) {
                    root.delete-scope = Math.max(0, root.delete-scope - 1);
                }
                return accept;
            }
            if (root.editor-visible) {
                // Keys its fields did not take.
                if (event.text == Key.Escape) {
                    root.editor-visible = false;
                } else if (event.modifiers.control && (event.text == "s" || event.text == Key.Return)) {
                    root.editor-save(root.editor, root.draft-calendar);
                }
                return accept;
            }
            if (root.draft-visible) {
                // Keys its title did not take.
                if (event.text == Key.Escape) {
                    root.close-draft();
                }
                return accept;
            }
            if (root.goto-visible) {
                // Keys its field did not take.
                if (event.text == Key.Escape) {
                    root.goto-visible = false;
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "+" || event.text == "=")) {
                root.zoom-by(1);
                return accept;
            }
            if (event.modifiers.control && event.text == "-") {
                root.zoom-by(-1);
                return accept;
            }
            if (event.modifiers.control && event.text == "0") {
                root.set-hour-height(48px);
                return accept;
            }
            if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                return reject;
            }
            if (root.settings-visible) {
                if (event.text == Key.Escape || event.text == "s") {
                    root.settings-visible = false;
                }
                return accept;
            }
            if (root.help-visible) {
                if (event.text == Key.Escape || event.text == "?") {
                    root.help-visible = false;
                }
                return accept;
            }
            if (event.text == "s") {
                root.settings-visible = true;
                return accept;
            }
            if (event.text == "g") {
                root.goto-visible = true;
                return accept;
            }
            if (root.view-menu-visible) {
                if (event.text == Key.Escape) {
                    root.view-menu-visible = false;
                    return accept;
                }
                // A view's key picks it, as with the menu closed.
                root.view-menu-visible = false;
            }
            if (event.text == Key.Escape && root.day-list-visible && !root.detail-visible) {
                root.day-list-visible = false;
                return accept;
            }
            if (event.text == Key.Escape && root.detail-visible) {
                root.detail-visible = false;
                return accept;
            }
            if ((event.text == Key.Delete || event.text == Key.Backspace) && root.detail-visible && root.detail.can-delete) {
                root.ask-delete();
                return accept;
            }
            if (event.text == "e" && root.detail-visible && root.detail.can-edit && !root.offline) {
                root.editor-requested(root.detail-instance);
                return accept;
            }
            if (event.text == "c") {
                root.ask-draft(-1, 0, false, 0, root.width / 2 - 200px, root.height / 3);
                return accept;
            }
            if (event.text == "z" && root.toast != "" && root.toast-undo) {
                root.undo();
                return accept;
            }
            if (event.text == "?") {
                root.help-visible = !root.help-visible;
                return accept;
            }
            if (event.text == "t") {
                root.go-today();
                return accept;
            }
            if (event.text == "j" || event.text == "n") {
                root.go-next();
                return accept;
            }
            if (event.text == "k" || event.text == "p") {
                root.go-previous();
                return accept;
            }
            if (event.text == "d" || event.text == "1") {
                root.set-view(0);
                return accept;
            }
            if (event.text == "w" || event.text == "2") {
                root.set-view(1);
                return accept;
            }
            if (event.text == "m" || event.text == "3") {
                root.set-view(2);
                return accept;
            }
            if (event.text == "x" || event.text == "4") {
                root.set-view(3);
                return accept;
            }
            if (event.text == "a" || event.text == "5") {
                root.set-view(4);
                return accept;
            }
            if (event.text == "y" || event.text == "6") {
                root.set-view(5);
                return accept;
            }
            if (event.text == "r") {
                root.sync-now();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Top bar.
            HorizontalLayout {
                height: 64px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Today");
                        outlined: true;
                        clicked => {
                            root.go-today();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: "‹";
                        width: 36px;
                        accessible-label: @tr("Previous");
                        clicked => {
                            root.go-previous();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: "›";
                        width: 36px;
                        accessible-label: @tr("Next");
                        clicked => {
                            root.go-next();
                        }
                    }
                }

                Text {
                    text: root.period-title;
                    font-size: 22px;
                    color: Theme.text;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 16px;
                }

                status := Text {
                    text: root.status-kind == StatusKind.waiting-for-browser ? @tr("Finish signing in in your browser…") : root.status-kind == StatusKind.syncing ? (root.status-detail != "" ? root.status-detail : @tr("Syncing…")) : root.status-kind == StatusKind.saving ? @tr("Saving…") : root.status-kind == StatusKind.failed ? root.status-detail : "";
                    font-size: 13px;
                    color: root.status-kind == StatusKind.failed ? Theme.danger : Theme.text-dim;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    max-width: 420px;
                }

                // The view, as a button that opens the list of views, as on the web.
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: "\{root.view-labels[root.view-index]}  ▾";
                        outlined: true;
                        accessible-label: @tr("View: {}", root.view-labels[root.view-index]);
                        clicked => {
                            root.view-menu-x = self.absolute-position.x;
                            root.view-menu-visible = true;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Refresh");
                        clicked => {
                            root.sync-now();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Settings");
                        clicked => {
                            root.settings-visible = true;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Add account");
                        outlined: true;
                        text-color: Theme.accent;
                        clicked => {
                            root.add-account();
                        }
                    }
                }
            }

            // Something is going on in the background: a bar running under the top bar.
            // A first sync of a large account takes minutes and must not look frozen.
            Rectangle {
                height: 3px;
                clip: true;

                if root.status-kind != StatusKind.idle && root.status-kind != StatusKind.failed: Rectangle {
                    property <float> phase: Math.mod(animation-tick() / 1ms, 1400) / 1400;
                    x: self.phase * (parent.width + self.width) - self.width;
                    width: parent.width / 4;
                    height: parent.height;
                    background: Theme.accent;
                    accessible-role: progress-indicator;
                    accessible-label: status.text;
                }
            }

            if root.offline: Rectangle {
                height: 36px;
                background: Theme.pressed;
                accessible-role: groupbox;
                accessible-label: offline-text.text;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 12px;

                    offline-text := Text {
                        text: @tr("No connection to Google. You see what was fetched last; changes can't be made until the connection is back.");
                        font-size: 13px;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: @tr("Try again");
                            height: 28px;
                            text-color: Theme.accent;
                            clicked => {
                                root.sync-now();
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                // Sidebar: accounts and their calendars.
                Flickable {
                    width: 256px;
                    interactive: false;
                    content-height: rows.preferred-height;

                    rows := VerticalLayout {
                        alignment: start;
                        padding-top: 8px;

                        // The small month.
                        Rectangle {
                            property <length> cell: 30px;
                            property <length> left: (self.width - 7 * self.cell) / 2;
                            height: 36px + 7 * self.cell + 12px;

                            Text {
                                x: parent.left + 8px;
                                y: 0;
                                height: 36px;
                                text: root.mini-title;
                                font-size: 14px;
                                font-weight: 500;
                                color: Theme.text;
                                vertical-alignment: center;
                            }

                            TextButton {
                                x: parent.left + 7 * parent.cell - 60px;
                                y: 4px;
                                width: 28px;
                                height: 28px;
                                text: "‹";
                                accessible-label: @tr("Previous month");
                                clicked => {
                                    root.mini-step(-1);
                                }
                            }

                            TextButton {
                                x: parent.left + 7 * parent.cell - 30px;
                                y: 4px;
                                width: 28px;
                                height: 28px;
                                text: "›";
                                accessible-label: @tr("Next month");
                                clicked => {
                                    root.mini-step(1);
                                }
                            }

                            for name[d] in root.weekday-names: Text {
                                x: parent.left + d * parent.cell;
                                y: 36px;
                                width: parent.cell;
                                height: parent.cell;
                                text: name;
                                font-size: 9px;
                                color: Theme.text-dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            for day[i] in root.mini-days: Rectangle {
                                x: parent.left + Math.mod(i, 7) * parent.cell + 2px;
                                y: 36px + parent.cell + Math.floor(i / 7) * parent.cell + 2px;
                                width: parent.cell - 4px;
                                height: parent.cell - 4px;
                                border-radius: self.height / 2;
                                background: day.today ? Theme.accent : day.shown ? Theme.selected : pick.has-hover ? Theme.hover : transparent;
                                accessible-role: button;
                                accessible-label: day.label;
                                accessible-action-default => {
                                    root.mini-pick(i);
                                }

                                Text {
                                    text: day.label;
                                    font-size: 11px;
                                    color: day.today ? Theme.on-accent : day.dim ? Theme.text-dim : Theme.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                pick := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.mini-pick(i);
                                    }
                                }
                            }
                        }

                        for row in root.sidebar: Rectangle {
                            height: row.is-account ? 44px : 30px;

                            // A calendar row is one big tick box, drawn under its content.
                            if !row.is-account: Rectangle {
                                background: tick.has-hover ? Theme.hover : transparent;
                                accessible-role: checkbox;
                                accessible-label: row.text;
                                accessible-checked: row.shown;
                                accessible-action-default => {
                                    tick.clicked();
                                }

                                tick := TouchArea {
                                    clicked => {
                                        root.toggle-calendar(row.account-id, row.calendar-id, !row.shown);
                                    }
                                }
                            }

                            if row.is-account: HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 8px;
                                spacing: 4px;

                                Text {
                                    text: row.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                if root.confirm-remove != row.email: VerticalLayout {
                                    alignment: center;
                                    TextButton {
                                        text: "✕";
                                        height: 28px;
                                        width: 28px;
                                        accessible-label: @tr("Remove account {}", row.email);
                                        clicked => {
                                            root.confirm-remove = row.email;
                                        }
                                    }
                                }
                                if root.confirm-remove == row.email: VerticalLayout {
                                    alignment: center;
                                    TextButton {
                                        text: @tr("Remove");
                                        height: 28px;
                                        text-color: Theme.danger;
                                        clicked => {
                                            root.confirm-remove = "";
                                            root.remove-account(row.email);
                                        }
                                    }
                                }
                                if root.confirm-remove == row.email: VerticalLayout {
                                    alignment: center;
                                    TextButton {
                                        text: @tr("Keep");
                                        height: 28px;
                                        clicked => {
                                            root.confirm-remove = "";
                                        }
                                    }
                                }
                            }
                            if !row.is-account: HorizontalLayout {
                                padding-left: 24px;
                                padding-right: 12px;
                                spacing: 12px;

                                Rectangle {
                                    width: 16px;
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 3px;
                                        border-width: 2px;
                                        border-color: row.color;
                                        background: row.shown ? row.color : transparent;
                                    }
                                }

                                Text {
                                    text: row.text;
                                    font-size: 13px;
                                    color: row.shown ? Theme.text : Theme.text-dim;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        if root.sidebar.length == 0: Text {
                            text: @tr("No accounts yet.\nChoose “Add account” to sign in.");
                            font-size: 13px;
                            color: Theme.text-dim;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                // The calendar.
                main := Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    // The day, 4-day and week views: day columns under an all-day strip.
                    Rectangle {
                        visible: !root.is-month && !root.is-schedule && !root.is-year;

                        // Day headers.
                        for day[d] in root.days: Rectangle {
                            x: gutter + d * day-w;
                            y: 0;
                            width: day-w;
                            height: head-h;

                            Text {
                                y: 10px;
                                width: parent.width;
                                text: day.weekday;
                                font-size: 11px;
                                font-weight: 500;
                                color: day.today ? Theme.accent : Theme.text-dim;
                                horizontal-alignment: center;
                            }

                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: 28px;
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: day.today ? Theme.accent : transparent;

                                Text {
                                    text: day.number;
                                    font-size: 24px;
                                    color: day.today ? Theme.on-accent : Theme.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // All-day strip.
                        for d in root.day-count: Rectangle {
                            x: gutter + d * day-w;
                            y: head-h;
                            width: 1px;
                            height: strip-h;
                            background: Theme.line;
                        }
                        // Empty part of the strip: a click starts an all-day event.
                        TouchArea {
                            x: gutter;
                            y: head-h;
                            width: parent.width - gutter;
                            height: strip-h;
                            clicked => {
                                root.ask-draft(Math.floor(self.mouse-x / day-w), 0, true, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                        for item in root.all-day: Rectangle {
                            // While it is dragged: by how many days, and where the pointer
                            // went down in the window (the bar moves under the pointer, so
                            // positions inside it cannot measure the drag).
                            property <bool> dragging;
                            property <int> drag-days;
                            property <length> press-x;
                            property <int> press-generation;

                            x: gutter + (item.first-day + self.drag-days) * day-w + 2px;
                            y: head-h + 2px + item.row * bar-h;
                            width: (item.last-day - item.first-day + 1) * day-w - 8px;
                            height: bar-h - 2px;
                            border-radius: 4px;
                            background: item.color;
                            opacity: self.dragging ? 0.7 : 1;
                            clip: true;

                            TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if (event.button != PointerEventButton.left) {
                                        return;
                                    }
                                    if (event.kind == PointerEventKind.down) {
                                        parent.press-x = self.absolute-position.x + self.mouse-x;
                                        parent.press-generation = root.generation;
                                    } else if (event.kind == PointerEventKind.up) {
                                        if (parent.dragging) {
                                            if (parent.drag-days != 0 && parent.press-generation == root.generation) {
                                                root.event-moved(item.instance, parent.drag-days, 0);
                                            }
                                            parent.dragging = false;
                                            parent.drag-days = 0;
                                        } else {
                                            root.show-detail(item.instance, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                }
                                moved => {
                                    if (item.movable && !root.offline && self.pressed) {
                                        if (parent.dragging || Math.abs(self.absolute-position.x + self.mouse-x - parent.press-x) > 6px) {
                                            parent.dragging = true;
                                            parent.drag-days = Math.max(-item.first-day, Math.min(root.day-count - 1 - item.last-day, Math.round((self.absolute-position.x + self.mouse-x - parent.press-x) / day-w)));
                                        }
                                    }
                                }
                            }

                            Text {
                                x: 8px;
                                width: parent.width - 12px;
                                text: item.title == "" ? @tr("(No title)") : item.title;
                                font-size: 12px;
                                font-weight: 500;
                                color: item.text-color;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            x: 0;
                            y: head-h + strip-h;
                            width: parent.width;
                            height: 1px;
                            background: Theme.line;
                        }

                        // Hour grid.
                        Rectangle {
                            x: 0;
                            y: head-h + strip-h + 1px;
                            width: parent.width;
                            height: parent.height - self.y;

                        // Two fingers moving apart or together zoom, on touch screens (and
                        // on touchpads where the system passes the gesture on).
                        ScaleRotateGestureHandler {
                            started => {
                                root.pinch-start = root.hour-h;
                            }
                            updated => {
                                root.set-hour-height(root.pinch-start * self.scale);
                            }

                        grid := Flickable {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            // Wheel and touchpad scrolling only; pointer drags are for events.
                            interactive: false;
                            content-width: self.width;
                            content-height: hour-h * 24;

                            // Empty time: a click starts a new event there. Events are drawn
                            // later, so theirs come first.
                            TouchArea {
                                x: gutter;
                                width: parent.width - gutter;
                                height: hour-h * 24;
                                scroll-event(event) => {
                                    if (event.modifiers.control) {
                                        root.zoom-wheel(event.delta-y);
                                        return accept;
                                    }
                                    reject
                                }
                                // A click is an hour from the half hour clicked; a drag
                                // marks the time out in quarters of an hour.
                                pointer-event(event) => {
                                    if (event.button != PointerEventButton.left) {
                                        return;
                                    }
                                    if (event.kind == PointerEventKind.down && !root.offline) {
                                        root.sel-day = Math.floor(self.mouse-x / day-w);
                                        root.sel-from = Math.floor(self.mouse-y / (hour-h / 4)) * 15;
                                        root.sel-start = root.sel-from;
                                        root.sel-end = root.sel-from;
                                    } else if (event.kind == PointerEventKind.up && root.sel-day >= 0) {
                                        if (root.sel-end - root.sel-start >= 30) {
                                            root.ask-draft(root.sel-day, root.sel-start, false, root.sel-end - root.sel-start, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                        } else {
                                            root.ask-draft(root.sel-day, Math.floor(root.sel-from / 30) * 30, false, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                        }
                                        root.sel-day = -1;
                                    }
                                }
                                moved => {
                                    if (self.pressed && root.sel-day >= 0) {
                                        root.sel-start = Math.max(0, Math.min(root.sel-from, Math.round(self.mouse-y / (hour-h / 4)) * 15));
                                        root.sel-end = Math.min(24 * 60, Math.max(root.sel-from, Math.round(self.mouse-y / (hour-h / 4)) * 15));
                                    }
                                }
                            }

                            for h in 24: Rectangle {
                                x: gutter - 8px;
                                y: h * hour-h;
                                width: grid.width - gutter + 8px;
                                height: 1px;
                                background: Theme.line;
                            }
                            for h in 24: Text {
                                x: 0;
                                y: h * hour-h - 7px;
                                width: gutter - 12px;
                                horizontal-alignment: right;
                                text: root.hour-labels[h];
                                font-size: 10px;
                                color: Theme.text-dim;
                            }
                            for d in root.day-count: Rectangle {
                                x: gutter + d * day-w;
                                y: 0;
                                width: 1px;
                                height: hour-h * 24;
                                background: Theme.line;
                            }

                            for item in root.timed: Rectangle {
                                property <length> slot-w: (day-w - 10px) / item.cols;
                                property <string> shown-title: item.title == "" ? @tr("(No title)") : item.title;

                                // While it is dragged: by how many days and minutes (in
                                // quarters of an hour), or by how many minutes its lower
                                // edge; and where the pointer went down in the window (the
                                // block moves under the pointer, so positions inside it
                                // cannot measure the drag).
                                property <bool> dragging;
                                property <int> drag-days;
                                property <int> drag-min;
                                property <int> grow-min;
                                property <length> press-x;
                                property <length> press-y;
                                property <int> press-generation;

                                x: self.dragging ? gutter + (item.day + self.drag-days) * day-w + 1px : gutter + item.day * day-w + 1px + item.col * slot-w;
                                y: (item.start-min + self.drag-min) / 60.0 * hour-h;
                                width: self.dragging ? day-w - 10px : slot-w - 1px;
                                height: (item.end-min - item.start-min + self.grow-min) / 60.0 * hour-h - 1px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.surface;
                                background: item.color;
                                opacity: self.dragging || self.grow-min != 0 ? 0.7 : 1;
                                clip: true;
                                accessible-role: list-item;
                                accessible-label: "\{self.shown-title}, \{item.time}";
                                accessible-action-default => {
                                    root.show-detail(item.instance, self.absolute-position.x, self.absolute-position.y);
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    scroll-event(event) => {
                                        if (event.modifiers.control) {
                                            root.zoom-wheel(event.delta-y);
                                            return accept;
                                        }
                                        reject
                                    }
                                    pointer-event(event) => {
                                        if (event.button != PointerEventButton.left) {
                                            return;
                                        }
                                        if (event.kind == PointerEventKind.down) {
                                            parent.press-x = self.absolute-position.x + self.mouse-x;
                                            parent.press-y = self.absolute-position.y + self.mouse-y;
                                            parent.press-generation = root.generation;
                                        } else if (event.kind == PointerEventKind.up) {
                                            if (parent.dragging) {
                                                if ((parent.drag-days != 0 || parent.drag-min != 0) && parent.press-generation == root.generation) {
                                                    root.event-moved(item.instance, parent.drag-days, parent.drag-min);
                                                }
                                                parent.dragging = false;
                                                parent.drag-days = 0;
                                                parent.drag-min = 0;
                                            } else {
                                                root.show-detail(item.instance, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                    moved => {
                                        if (item.movable && !root.offline && self.pressed) {
                                            if (parent.dragging || Math.abs(self.absolute-position.x + self.mouse-x - parent.press-x) > 6px || Math.abs(self.absolute-position.y + self.mouse-y - parent.press-y) > 6px) {
                                                parent.dragging = true;
                                                parent.drag-days = Math.max(-item.day, Math.min(root.day-count - 1 - item.day, Math.round((self.absolute-position.x + self.mouse-x - parent.press-x) / day-w)));
                                                parent.drag-min = Math.max(-item.start-min, Math.min(24 * 60 - item.end-min, Math.round((self.absolute-position.y + self.mouse-y - parent.press-y) / (hour-h / 4)) * 15));
                                            }
                                        }
                                    }
                                }

                                // The lower edge: dragging it changes when the event ends.
                                if item.resizable && !root.offline: TouchArea {
                                    y: parent.height - self.height;
                                    height: Math.min(8px, parent.height / 3);
                                    mouse-cursor: ns-resize;
                                    pointer-event(event) => {
                                        if (event.button != PointerEventButton.left) {
                                            return;
                                        }
                                        if (event.kind == PointerEventKind.down) {
                                            parent.press-y = self.absolute-position.y + self.mouse-y;
                                            parent.press-generation = root.generation;
                                        } else if (event.kind == PointerEventKind.up) {
                                            if (parent.grow-min != 0 && parent.press-generation == root.generation) {
                                                root.event-resized(item.instance, parent.grow-min);
                                            }
                                            parent.grow-min = 0;
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            parent.grow-min = Math.max(15 - (item.end-min - item.start-min), Math.min(24 * 60 - item.end-min, Math.round((self.absolute-position.y + self.mouse-y - parent.press-y) / (hour-h / 4)) * 15));
                                        }
                                    }
                                }

                                // Short blocks have room for one line only.
                                if parent.height <= 34px: Text {
                                    x: 6px;
                                    y: 0;
                                    width: parent.width - 8px;
                                    height: parent.height;
                                    text: "\{parent.shown-title}, \{item.time}";
                                    // Zoomed far out, a short event is only a few pixels high.
                                    font-size: Math.min(12px, Math.max(7px, parent.height - 3px));
                                    color: item.text-color;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if parent.height > 34px: Text {
                                    x: 6px;
                                    y: 3px;
                                    width: parent.width - 8px;
                                    text: parent.shown-title;
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: item.text-color;
                                    overflow: elide;
                                }
                                if parent.height > 34px: Text {
                                    x: 6px;
                                    y: 19px;
                                    width: parent.width - 8px;
                                    text: item.time;
                                    font-size: 11px;
                                    color: item.text-color;
                                    overflow: elide;
                                }
                            }

                            // The new event being typed in.
                            if root.draft-visible && root.draft-day >= 0: Rectangle {
                                x: gutter + root.draft-day * day-w + 1px;
                                y: root.draft-min / 60.0 * hour-h;
                                width: day-w - 10px;
                                height: root.draft-len / 60.0 * hour-h - 1px;
                                border-radius: 4px;
                                background: Theme.accent;
                                opacity: 0.6;
                            }

                            // The time being dragged out for a new event.
                            if root.sel-day >= 0 && root.sel-end - root.sel-start >= 15: Rectangle {
                                x: gutter + root.sel-day * day-w + 1px;
                                y: root.sel-start / 60.0 * hour-h;
                                width: day-w - 10px;
                                height: (root.sel-end - root.sel-start) / 60.0 * hour-h - 1px;
                                border-radius: 4px;
                                background: Theme.accent;
                                opacity: 0.6;
                            }

                            // Current time.
                            if root.now-day >= 0: Rectangle {
                                x: gutter + root.now-day * day-w;
                                y: root.now-min / 60.0 * hour-h - 1px;
                                width: day-w;
                                height: 2px;
                                background: Theme.now;
                            }
                            if root.now-day >= 0: Rectangle {
                                x: gutter + root.now-day * day-w - 6px;
                                y: root.now-min / 60.0 * hour-h - 6px;
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: Theme.now;
                            }
                        }
                        }
                        }
                    }

                    // The month: a row of weekday names, then one row per week.
                    Rectangle {
                        visible: root.is-month;

                        for name[d] in root.weekday-names: Text {
                            x: d * month-col-w;
                            y: 0;
                            width: month-col-w;
                            height: month-names-h;
                            text: name;
                            font-size: 11px;
                            font-weight: 500;
                            color: Theme.text-dim;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        for cell[i] in root.month-cells: Rectangle {
                            x: Math.mod(i, 7) * month-col-w;
                            y: month-names-h + Math.floor(i / 7) * month-row-h;
                            width: month-col-w;
                            height: month-row-h;

                            // An empty part of the cell: a click starts an all-day event.
                            TouchArea {
                                clicked => {
                                    root.ask-draft(i, 0, true, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: 1px;
                                height: parent.height;
                                background: Theme.line;
                            }
                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: 1px;
                                background: Theme.line;
                            }

                            // The day's number opens that day.
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: 4px;
                                width: Math.max(24px, number.preferred-width + 12px);
                                height: 24px;
                                border-radius: 12px;
                                background: cell.today ? Theme.accent : number-touch.has-hover ? Theme.hover : transparent;
                                accessible-role: button;
                                accessible-label: cell.label;
                                accessible-action-default => {
                                    root.open-day(i);
                                }

                                number := Text {
                                    text: cell.label;
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: cell.today ? Theme.on-accent : cell.dim ? Theme.text-dim : Theme.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                number-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.open-day(i);
                                    }
                                }
                            }

                            // What did not fit, on the cell's last line.
                            if cell.more > 0: Rectangle {
                                x: 2px;
                                y: month-number-h + (root.month-capacity - 1) * bar-h;
                                width: parent.width - 6px;
                                height: bar-h - 2px;
                                border-radius: 4px;
                                background: more-touch.has-hover ? Theme.hover : transparent;
                                accessible-role: button;
                                accessible-label: more.text;
                                accessible-action-default => {
                                    root.ask-day-list(i, self.absolute-position.x, self.absolute-position.y);
                                }

                                more := Text {
                                    x: 8px;
                                    width: parent.width - 12px;
                                    text: @tr("{} more", cell.more);
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                more-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.ask-day-list(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }
                        }
                        for chip in root.month-chips: Rectangle {
                            property <string> shown-title: chip.title == "" ? @tr("(No title)") : chip.title;

                            x: chip.first-day * month-col-w + 2px;
                            y: month-names-h + chip.week * month-row-h + month-number-h + chip.row * bar-h;
                            width: (chip.last-day - chip.first-day + 1) * month-col-w - 6px;
                            height: bar-h - 2px;
                            border-radius: 4px;
                            background: chip.filled ? chip.color : chip-touch.has-hover ? Theme.hover : transparent;
                            clip: true;
                            accessible-role: list-item;
                            accessible-label: chip.time == "" ? self.shown-title : "\{self.shown-title}, \{chip.time}";
                            accessible-action-default => {
                                root.show-detail(chip.instance, self.absolute-position.x, self.absolute-position.y);
                            }

                            chip-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.show-detail(chip.instance, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }

                            // Events within a day are a dot in the calendar's colour, the time and the title.
                            if !chip.filled: Rectangle {
                                x: 6px;
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: chip.color;
                            }
                            Text {
                                x: chip.filled ? 8px : 20px;
                                width: parent.width - self.x - 4px;
                                text: chip.filled ? parent.shown-title : "\{chip.time} \{parent.shown-title}";
                                font-size: 12px;
                                font-weight: chip.filled ? 500 : 400;
                                color: chip.filled ? chip.text-color : Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    // The year: twelve small months, four in a row. A day opens that day.
                    if root.is-year: year := Rectangle {
                        property <length> month-w: self.width / 4;
                        property <length> month-h: self.height / 3;
                        property <length> cell: Math.max(14px, Math.min((self.month-w - 32px) / 7, (self.month-h - 44px) / 7));

                        for name[m] in root.year-months: Rectangle {
                            property <length> left: (self.width - 7 * parent.cell) / 2;
                            x: Math.mod(m, 4) * parent.month-w;
                            y: Math.floor(m / 4) * parent.month-h;
                            width: parent.month-w;
                            height: parent.month-h;

                            Text {
                                x: parent.left + 6px;
                                y: 8px;
                                height: 24px;
                                text: name;
                                font-size: 14px;
                                font-weight: 500;
                                color: Theme.text;
                                vertical-alignment: center;
                            }

                            for weekday[d] in root.weekday-names: Text {
                                x: parent.left + d * year.cell;
                                y: 32px;
                                width: year.cell;
                                height: 12px;
                                text: weekday;
                                font-size: 8px;
                                color: Theme.text-dim;
                                horizontal-alignment: center;
                            }
                        }
                        for day[i] in root.year-days: Rectangle {
                            property <int> m: Math.floor(i / 42);
                            property <int> at: Math.mod(i, 42);
                            property <length> left: (parent.month-w - 7 * parent.cell) / 2;
                            // Days of the neighbouring months are left out, as on the web.
                            visible: !day.dim;
                            x: Math.mod(self.m, 4) * parent.month-w + self.left + Math.mod(self.at, 7) * parent.cell + 1px;
                            y: Math.floor(self.m / 4) * parent.month-h + 46px + Math.floor(self.at / 7) * parent.cell + 1px;
                            width: parent.cell - 2px;
                            height: parent.cell - 2px;
                            border-radius: self.height / 2;
                            background: day.today ? Theme.accent : year-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: "\{root.year-months[self.m]} \{day.label}";
                            accessible-action-default => {
                                root.year-pick(i);
                            }

                            Text {
                                text: day.label;
                                font-size: Math.min(12px, parent.height * 0.5);
                                color: day.today ? Theme.on-accent : Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            year-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.year-pick(i);
                                }
                            }
                        }
                    }
                    // The schedule: the coming days' events as a list.
                    Flickable {
                        visible: root.is-schedule;
                        interactive: false;
                        content-height: agenda.preferred-height;

                        agenda := VerticalLayout {
                            alignment: start;
                            padding-top: 8px;
                            padding-bottom: 16px;

                            for row in root.schedule: Rectangle {
                                height: 40px;
                                background: row-touch.has-hover ? Theme.hover : transparent;
                                accessible-role: list-item;
                                accessible-label: "\{row.day-number} \{row.day-name}, \{row.time}, \{row.title}";
                                accessible-action-default => {
                                    root.show-detail(row.instance, self.absolute-position.x + 200px, self.absolute-position.y);
                                }

                                if row.first-of-day: Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: 1px;
                                    background: Theme.line;
                                }

                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-detail(row.instance, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }

                                if row.first-of-day: Rectangle {
                                    x: 16px;
                                    y: (parent.height - self.height) / 2;
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: row.today ? Theme.accent : transparent;

                                    Text {
                                        text: row.day-number;
                                        font-size: 18px;
                                        color: row.today ? Theme.on-accent : Theme.text;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                if row.first-of-day: Text {
                                    x: 56px;
                                    width: 80px;
                                    height: parent.height;
                                    text: row.day-name;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: row.today ? Theme.accent : Theme.text-dim;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    x: 150px;
                                    y: (parent.height - self.height) / 2;
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 6px;
                                    background: row.color;
                                }

                                Text {
                                    x: 178px;
                                    width: 130px;
                                    height: parent.height;
                                    text: row.time;
                                    font-size: 14px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }

                                Text {
                                    x: 316px;
                                    width: parent.width - self.x - 16px;
                                    height: parent.height;
                                    text: row.title == "" ? @tr("(No title)") : row.title;
                                    font-size: 14px;
                                    font-weight: 500;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            if root.schedule.length == 0: Text {
                                height: 80px;
                                text: @tr("Nothing planned in these days.");
                                font-size: 14px;
                                color: Theme.text-dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // The list of views, under its button.
        if root.view-menu-visible: TouchArea {
            clicked => {
                root.view-menu-visible = false;
            }
        }
        if root.view-menu-visible: Rectangle {
            x: Math.max(12px, Math.min(root.view-menu-x, root.width - self.width - 12px));
            y: 56px;
            width: 200px;
            height: view-menu-box.preferred-height;
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
            clip: true;
            accessible-role: groupbox;
            accessible-label: @tr("View");

            view-menu-box := VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;

                for label[index] in root.view-labels: Rectangle {
                    height: 36px;
                    background: root.view-index == index ? Theme.selected : view-touch.has-hover ? Theme.hover : transparent;
                    accessible-role: list-item;
                    accessible-label: label;
                    accessible-item-selected: root.view-index == index;
                    accessible-action-default => {
                        root.view-menu-visible = false;
                        root.set-view(index);
                    }

                    view-touch := TouchArea {
                        clicked => {
                            root.view-menu-visible = false;
                            root.set-view(index);
                        }
                    }

                    Text {
                        x: 16px;
                        height: parent.height;
                        text: label;
                        font-size: 14px;
                        color: Theme.text;
                        vertical-alignment: center;
                    }

                    Text {
                        x: parent.width - 16px - self.width;
                        height: parent.height;
                        text: root.view-keys[index];
                        font-size: 12px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // All events of a day of the month view. Under the details card, which opens
        // from it.
        if root.day-list-visible: TouchArea {
            clicked => {
                root.day-list-visible = false;
            }
        }
        if root.day-list-visible: Rectangle {
            property <length> margin: 12px;
            width: Math.min(300px, root.width - 2 * self.margin);
            height: Math.min(day-list-box.preferred-height, root.height - 2 * self.margin);
            x: Math.max(self.margin, Math.min(root.day-list-x - 40px, root.width - self.width - self.margin));
            y: Math.max(self.margin, Math.min(root.day-list-y - 60px, root.height - self.height - self.margin));
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            clip: true;
            accessible-role: groupbox;
            accessible-label: root.day-list-title;

            TouchArea { }

            Flickable {
                interactive: false;
                content-height: day-list-box.preferred-height;

                day-list-box := VerticalLayout {
                    padding: 12px;
                    spacing: 2px;

                    HorizontalLayout {
                        Text {
                            text: root.day-list-title;
                            font-size: 15px;
                            font-weight: 500;
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        TextButton {
                            text: "✕";
                            height: 28px;
                            width: 28px;
                            accessible-label: @tr("Close");
                            clicked => {
                                root.day-list-visible = false;
                            }
                        }
                    }

                    for row in root.day-list: Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: list-touch.has-hover ? Theme.hover : transparent;
                        accessible-role: list-item;
                        accessible-label: "\{row.title == "" ? @tr("(No title)") : row.title}, \{row.time}";
                        accessible-action-default => {
                            root.show-detail(row.instance, self.absolute-position.x, self.absolute-position.y);
                        }

                        list-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-detail(row.instance, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }

                        Rectangle {
                            x: 6px;
                            y: (parent.height - self.height) / 2;
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: row.color;
                        }

                        Text {
                            x: 24px;
                            width: parent.width - 28px;
                            height: parent.height;
                            text: "\{row.time}  \{row.title == "" ? @tr("(No title)") : row.title}";
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // Event details. An overlay inside the window: we place it ourselves so that it
        // never leaves the window (M0 finding), and it does not take keyboard focus.
        if root.detail-visible: TouchArea {
            // Clicking anywhere else closes it.
            clicked => {
                root.detail-visible = false;
            }
        }
        if root.detail-visible: card := Rectangle {
            property <length> margin: 12px;
            width: Math.min(420px, root.width - 2 * self.margin);
            height: Math.min(content.preferred-height, root.height - 2 * self.margin);
            // Beside the click, shifted back inside the window where it would not fit.
            x: Math.max(self.margin, Math.min(root.detail-x + 12px, root.width - self.width - self.margin));
            y: Math.max(self.margin, Math.min(root.detail-y - 24px, root.height - self.height - self.margin));
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            clip: true;
            accessible-role: groupbox;
            accessible-label: root.detail.title;

            // Swallows clicks on the card itself.
            TouchArea { }

            content := VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    if root.detail.can-edit && !root.offline: TextButton {
                        text: @tr("Edit");
                        height: 32px;
                        clicked => {
                            root.editor-requested(root.detail-instance);
                        }
                    }
                    if root.detail.can-delete && !root.offline: TextButton {
                        text: @tr("Delete");
                        height: 32px;
                        text-color: Theme.danger;
                        clicked => {
                            root.ask-delete();
                        }
                    }
                    if root.detail.link != "": TextButton {
                        text: @tr("Open in browser");
                        height: 32px;
                        clicked => {
                            root.open-link(root.detail.link);
                        }
                    }
                    TextButton {
                        text: "✕";
                        height: 32px;
                        width: 32px;
                        accessible-label: @tr("Close");
                        clicked => {
                            root.detail-visible = false;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 16px;
                        Rectangle {
                            y: 6px;
                            width: 16px;
                            height: 16px;
                            border-radius: 4px;
                            background: root.detail.color;
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: root.detail.title == "" ? @tr("(No title)") : root.detail.title;
                            font-size: 20px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }

                        Text {
                            text: root.detail.when;
                            font-size: 13px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }

                        if root.detail.zone != "": Text {
                            text: root.detail.zone;
                            font-size: 12px;
                            color: Theme.text-dim;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.detail.meet != "": HorizontalLayout {
                    alignment: start;
                    TextButton {
                        text: @tr("Join the video meeting");
                        height: 34px;
                        filled: true;
                        clicked => {
                            root.open-link(root.detail.meet);
                        }
                    }
                }
                if root.detail.guests.length > 0: VerticalLayout {
                    spacing: 2px;

                    Text {
                        text: root.detail.guests.length == 1 ? @tr("1 guest") : @tr("{} guests", root.detail.guests.length);
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.text-dim;
                    }

                    Flickable {
                        height: Math.min(6, root.detail.guests.length) * 24px;
                        interactive: false;
                        content-height: root.detail.guests.length * 24px;

                        for guest[i] in root.detail.guests: Rectangle {
                            y: i * 24px;
                            height: 24px;
                            accessible-role: list-item;
                            accessible-label: "\{guest.name}, \{guest.status == 1 ? @tr("yes") : guest.status == 2 ? @tr("no") : guest.status == 3 ? @tr("maybe") : @tr("no answer yet")}";

                            // Green for yes, red for no, hollow while unanswered or unsure.
                            Rectangle {
                                x: 2px;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                border-width: 2px;
                                border-color: guest.status == 1 ? #34a853 : guest.status == 2 ? Theme.danger : Theme.text-dim;
                                background: guest.status == 1 ? #34a853 : guest.status == 2 ? Theme.danger : transparent;
                            }

                            Text {
                                x: 22px;
                                width: parent.width - 22px;
                                height: parent.height;
                                text: guest.organizer ? @tr("{} (organiser)", guest.name) : guest.optional ? @tr("{} (optional)", guest.name) : guest.status == 3 ? @tr("{} (maybe)", guest.name) : guest.name;
                                font-size: 13px;
                                color: Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
                if root.detail.rsvp >= 0 && !root.offline: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: @tr("Going?");
                        font-size: 13px;
                        color: Theme.text;
                        vertical-alignment: center;
                    }

                    for answer[i] in [@tr("Yes"), @tr("No"), @tr("Maybe")]: TextButton {
                        text: answer;
                        height: 30px;
                        outlined: true;
                        filled: root.detail.rsvp == i + 1;
                        clicked => {
                            root.rsvp(root.detail-instance, i + 1);
                            root.detail-visible = false;
                        }
                    }
                }
                if root.detail.location != "": Text {
                    text: root.detail.location;
                    font-size: 13px;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if root.detail.description != "": Text {
                    text: root.detail.description;
                    font-size: 13px;
                    color: Theme.text;
                    wrap: word-wrap;
                    // Long descriptions are cut; the full, formatted text comes with M3.
                    max-height: 220px;
                    overflow: elide;
                }
                Text {
                    text: root.detail.calendar == root.detail.account ? root.detail.account : "\{root.detail.calendar} · \{root.detail.account}";
                    font-size: 12px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
            }
        }

        // Before deleting a repeating event or one with guests: how much, and whether
        // the guests are told.
        if root.delete-ask-visible: Rectangle {
            background: #00000066;
            TouchArea {
                clicked => {
                    root.delete-ask-visible = false;
                }
            }
        }
        if root.delete-ask-visible: Rectangle {
            width: Math.min(360px, root.width - 24px);
            height: Math.min(delete-box.preferred-height, root.height - 24px);
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            clip: true;
            accessible-role: groupbox;
            accessible-label: delete-title.text;

            TouchArea { }

            delete-box := VerticalLayout {
                padding: 24px;
                padding-bottom: 12px;
                spacing: 6px;

                delete-title := Text {
                    text: root.ask-edit ? @tr("Edit repeating event") : root.detail.repeating ? @tr("Delete repeating event") : @tr("Delete event");
                    font-size: 18px;
                    color: Theme.text;
                }

                Rectangle {
                    height: 8px;
                }

                if root.ask-edit || root.detail.repeating: VerticalLayout {
                    for label[i] in [@tr("This event"), @tr("This and following events"), @tr("All events")]: RadioRow {
                        text: label;
                        selected: root.delete-scope == i;
                        clicked => {
                            root.delete-scope = i;
                        }
                    }
                }
                if !root.ask-edit && root.detail.notify-guests: Rectangle {
                    height: 36px;
                    border-radius: 4px;
                    background: notify-touch.has-hover ? Theme.hover : transparent;
                    accessible-role: checkbox;
                    accessible-label: notify-label.text;
                    accessible-checked: root.delete-notify;
                    accessible-action-default => {
                        root.delete-notify = !root.delete-notify;
                    }

                    notify-touch := TouchArea {
                        clicked => {
                            root.delete-notify = !root.delete-notify;
                        }
                    }

                    Rectangle {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        border-radius: 3px;
                        border-width: 2px;
                        border-color: root.delete-notify ? Theme.accent : Theme.text-dim;
                        background: root.delete-notify ? Theme.accent : transparent;
                    }

                    notify-label := Text {
                        x: 40px;
                        height: parent.height;
                        text: @tr("Send cancellation e-mails to guests");
                        font-size: 14px;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    padding-top: 8px;
                    TextButton {
                        text: @tr("Cancel");
                        height: 32px;
                        clicked => {
                            root.delete-ask-visible = false;
                        }
                    }

                    TextButton {
                        text: root.ask-edit ? @tr("OK") : @tr("Delete");
                        height: 32px;
                        text-color: root.ask-edit ? Theme.accent : Theme.danger;
                        clicked => {
                            root.confirm-ask();
                        }
                    }
                }
            }
        }

        // A new event. Unlike the other cards this one is typed into, so its text field
        // takes the keyboard until the card closes.
        if root.draft-visible: TouchArea {
            clicked => {
                root.close-draft();
            }
        }
        if root.draft-visible: Rectangle {
            property <length> margin: 12px;
            width: Math.min(400px, root.width - 2 * self.margin);
            height: Math.min(draft.preferred-height, root.height - 2 * self.margin);
            x: Math.max(self.margin, Math.min(root.detail-x + 12px, root.width - self.width - self.margin));
            y: Math.max(self.margin, Math.min(root.detail-y - 24px, root.height - self.height - self.margin));
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            clip: true;
            accessible-role: groupbox;
            accessible-label: @tr("New event");

            TouchArea { }

            draft := VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: end;
                    TextButton {
                        text: "✕";
                        height: 32px;
                        width: 32px;
                        accessible-label: @tr("Close");
                        clicked => {
                            root.close-draft();
                        }
                    }
                }

                // The title: a line to write on, as on the web.
                Rectangle {
                    height: 40px;

                    if draft-title.text == "": Text {
                        x: 2px;
                        text: @tr("Add title");
                        font-size: 20px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                    draft-title := TextInput {
                        x: 2px;
                        width: parent.width - 4px;
                        font-size: 20px;
                        color: Theme.text;
                        vertical-alignment: center;
                        single-line: true;
                        accessible-label: @tr("Title");
                        init => {
                            self.focus();
                        }
                        accepted => {
                            root.draft-save(self.text, root.draft-calendar);
                            root.close-draft();
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.close-draft();
                                return accept;
                            }
                            reject
                        }
                    }

                    Rectangle {
                        y: parent.height - self.height;
                        height: draft-title.has-focus ? 2px : 1px;
                        background: draft-title.has-focus ? Theme.accent : Theme.line;
                    }
                }

                Text {
                    text: root.draft-when;
                    font-size: 14px;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                // Which calendar it goes into, of all accounts.
                Choice {
                    options: root.editor-calendars;
                    current: root.draft-calendar;
                    chosen(i) => {
                        root.draft-calendar = i;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    padding-top: 4px;
                    TextButton {
                        text: @tr("More options");
                        height: 36px;
                        text-color: Theme.accent;
                        clicked => {
                            root.editor-from-draft(draft-title.text, root.draft-calendar);
                        }
                    }

                    TextButton {
                        text: @tr("Save");
                        height: 36px;
                        filled: true;
                        clicked => {
                            root.draft-save(draft-title.text, root.draft-calendar);
                            root.close-draft();
                        }
                    }
                }
            }
        }

        // The editor. Its fields take the keyboard; what they leave reaches the
        // window's key handler, which knows the editor is open.
        if root.editor-visible: Rectangle {
            background: #00000066;
            TouchArea { }
        }
        if root.editor-visible: Rectangle {
            width: Math.min(560px, root.width - 24px);
            height: Math.min(editor-form.preferred-height, root.height - 24px);
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            clip: true;
            accessible-role: groupbox;
            accessible-label: root.editor-new ? @tr("New event") : @tr("Edit event");

            TouchArea { }

            Flickable {
                interactive: false;
                content-height: editor-form.preferred-height;

                editor-form := VerticalLayout {
                    padding: 20px;
                    padding-bottom: 12px;
                    spacing: 8px;

                    Field {
                        height: 44px;
                        hint: @tr("Add title");
                        text-size: 18px;
                        take-focus: true;
                        value: root.editor.title;
                        edited(text) => {
                            root.editor.title = text;
                        }
                    }

                    EditorRow {
                        label: @tr("Starts");
                        Field {
                            hint: "2026-11-17";
                            value: root.editor.start-date;
                            edited(text) => {
                                root.editor.start-date = text;
                            }
                        }

                        if !root.editor.all-day: Field {
                            width: 110px;
                            hint: "9:30";
                            value: root.editor.start-time;
                            edited(text) => {
                                root.editor.start-time = text;
                            }
                        }
                    }

                    EditorRow {
                        label: @tr("Ends");
                        Field {
                            hint: "2026-11-17";
                            value: root.editor.end-date;
                            edited(text) => {
                                root.editor.end-date = text;
                            }
                        }

                        if !root.editor.all-day: Field {
                            width: 110px;
                            hint: "10:30";
                            value: root.editor.end-time;
                            edited(text) => {
                                root.editor.end-time = text;
                            }
                        }
                    }

                    EditorRow {
                        label: "";
                        CheckRow {
                            text: @tr("All day");
                            checked: root.editor.all-day;
                            toggled => {
                                root.editor.all-day = !root.editor.all-day;
                            }
                        }
                    }

                    EditorRow {
                        label: @tr("Repeats");
                        Choice {
                            options: root.editor-custom-repeat ? [@tr("Does not repeat"), @tr("Daily"), @tr("Weekly on the same weekday"), @tr("Monthly on the same day"), @tr("Annually on the same date"), @tr("Every weekday (Monday to Friday)"), @tr("As it repeats now")] : [@tr("Does not repeat"), @tr("Daily"), @tr("Weekly on the same weekday"), @tr("Monthly on the same day"), @tr("Annually on the same date"), @tr("Every weekday (Monday to Friday)")];
                            current: root.editor.repeat;
                            chosen(i) => {
                                root.editor.repeat = i;
                            }
                        }
                    }

                    EditorRow {
                        label: @tr("Where");
                        Field {
                            hint: @tr("Add location");
                            value: root.editor.location;
                            edited(text) => {
                                root.editor.location = text;
                            }
                        }
                    }

                    EditorRow {
                        label: @tr("Description");
                        Field {
                            multiline: true;
                            hint: @tr("Add description");
                            value: root.editor.description;
                            edited(text) => {
                                root.editor.description = text;
                            }
                        }
                    }

                    EditorRow {
                        label: @tr("Calendar");
                        if root.editor-new: Choice {
                            options: root.editor-calendars;
                            current: root.draft-calendar;
                            chosen(i) => {
                                root.draft-calendar = i;
                            }
                        }
                        if !root.editor-new: Text {
                            height: 36px;
                            text: root.editor-calendar-name;
                            font-size: 14px;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    EditorRow {
                        label: @tr("Colour");
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            for swatch[i] in root.editor-colors: Rectangle {
                                width: 28px;
                                height: 36px;
                                accessible-role: list-item;
                                accessible-label: i == 0 ? @tr("Calendar colour") : @tr("Colour {}", i);
                                accessible-item-selected: root.editor.color == i;
                                accessible-action-default => {
                                    root.editor.color = i;
                                }

                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: swatch;
                                    border-width: root.editor.color == i ? 3px : 0px;
                                    border-color: Theme.text;
                                }

                                TouchArea {
                                    clicked => {
                                        root.editor.color = i;
                                    }
                                }
                            }
                        }
                    }

                    EditorRow {
                        label: @tr("Reminder");
                        Choice {
                            options: root.editor-custom-reminder ? [@tr("The calendar's usual reminders"), @tr("None"), @tr("When it starts"), @tr("5 minutes before"), @tr("10 minutes before"), @tr("15 minutes before"), @tr("30 minutes before"), @tr("1 hour before"), @tr("1 day before"), @tr("As it reminds now")] : [@tr("The calendar's usual reminders"), @tr("None"), @tr("When it starts"), @tr("5 minutes before"), @tr("10 minutes before"), @tr("15 minutes before"), @tr("30 minutes before"), @tr("1 hour before"), @tr("1 day before")];
                            current: root.editor.reminder;
                            chosen(i) => {
                                root.editor.reminder = i;
                            }
                        }
                    }

                    EditorRow {
                        label: @tr("Visibility");
                        Choice {
                            options: [@tr("The calendar's default"), @tr("Public"), @tr("Private")];
                            current: root.editor.visibility;
                            chosen(i) => {
                                root.editor.visibility = i;
                            }
                        }
                    }

                    EditorRow {
                        label: @tr("Shown as");
                        Choice {
                            options: [@tr("Busy"), @tr("Free")];
                            current: root.editor.busy ? 0 : 1;
                            chosen(i) => {
                                root.editor.busy = i == 0;
                            }
                        }
                    }

                    if root.editor-error != "": Text {
                        text: root.editor-error;
                        font-size: 13px;
                        color: Theme.danger;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 4px;
                        padding-top: 4px;
                        TextButton {
                            text: @tr("Cancel");
                            height: 32px;
                            clicked => {
                                root.editor-visible = false;
                            }
                        }

                        TextButton {
                            text: @tr("Save");
                            height: 32px;
                            filled: true;
                            clicked => {
                                root.editor-save(root.editor, root.draft-calendar);
                            }
                        }
                    }
                }
            }
        }

        // What just happened, with the way back. Bottom left, as on the web.
        if root.toast != "": Rectangle {
            x: 24px;
            y: root.height - self.height - 24px;
            width: toast-row.preferred-width;
            height: 48px;
            border-radius: 4px;
            background: #323232;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: #00000040;
            accessible-role: groupbox;
            accessible-label: root.toast;

            toast-row := HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 16px;

                Text {
                    text: root.toast;
                    font-size: 14px;
                    color: white;
                    vertical-alignment: center;
                }

                if root.toast-undo: VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Undo");
                        height: 32px;
                        text-color: #8ab4f8;
                        clicked => {
                            root.undo();
                        }
                    }
                }
            }
        }

        // A message that must be read: dims the window and waits for "OK".
        if root.notice != "": Rectangle {
            background: #00000066;
            TouchArea { }
        }
        if root.notice != "": Rectangle {
            width: Math.min(440px, root.width - 24px);
            height: Math.min(notice-box.preferred-height, root.height - 24px);
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            clip: true;
            accessible-role: groupbox;
            accessible-label: root.notice;

            notice-box := VerticalLayout {
                padding: 24px;
                padding-bottom: 12px;
                spacing: 16px;

                Text {
                    text: root.notice;
                    font-size: 14px;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    TextButton {
                        text: @tr("OK");
                        height: 32px;
                        text-color: Theme.accent;
                        clicked => {
                            root.notice = "";
                        }
                    }
                }
            }
        }

        // Go to date.
        if root.goto-visible: Rectangle {
            background: #00000066;
            TouchArea {
                clicked => {
                    root.goto-visible = false;
                }
            }
        }
        if root.goto-visible: Rectangle {
            width: Math.min(340px, root.width - 24px);
            height: Math.min(goto-box.preferred-height, root.height - 24px);
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            clip: true;
            accessible-role: groupbox;
            accessible-label: @tr("Go to date");

            TouchArea { }

            goto-box := VerticalLayout {
                padding: 20px;
                padding-bottom: 12px;
                spacing: 10px;

                Text {
                    text: @tr("Go to date");
                    font-size: 18px;
                    color: Theme.text;
                }

                goto-field := Field {
                    hint: @tr("17.11.2026, 2026-11-17, tomorrow…");
                    take-focus: true;
                    property <string> typed;
                    edited(text) => {
                        self.typed = text;
                    }
                    accepted(text) => {
                        root.goto-date(text);
                    }
                }

                if root.goto-error != "": Text {
                    text: root.goto-error;
                    font-size: 13px;
                    color: Theme.danger;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    TextButton {
                        text: @tr("Cancel");
                        height: 32px;
                        clicked => {
                            root.goto-visible = false;
                        }
                    }

                    TextButton {
                        text: @tr("Go");
                        height: 32px;
                        filled: true;
                        clicked => {
                            root.goto-date(goto-field.typed);
                        }
                    }
                }
            }
        }

        // Settings. Kept on this computer, for all accounts.
        if root.settings-visible: Rectangle {
            background: #00000066;
            TouchArea {
                clicked => {
                    root.settings-visible = false;
                }
            }
        }
        if root.settings-visible: Rectangle {
            width: Math.min(380px, root.width - 24px);
            height: Math.min(settings-box.preferred-height, root.height - 24px);
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            clip: true;
            accessible-role: groupbox;
            accessible-label: @tr("Settings");

            TouchArea { }

            // Taller than a small window when its lists are open: the wheel scrolls it.
            Flickable {
                interactive: false;
                content-height: settings-box.preferred-height;

            settings-box := VerticalLayout {
                padding: 24px;
                padding-bottom: 12px;
                spacing: 4px;

                Text {
                    text: @tr("Settings");
                    font-size: 18px;
                    color: Theme.text;
                }

                Rectangle {
                    height: 12px;
                }

                Text {
                    text: @tr("Theme");
                    font-size: 12px;
                    font-weight: 500;
                    color: Theme.text-dim;
                }

                for label[i] in [@tr("Same as the desktop"), @tr("Light"), @tr("Dark")]: RadioRow {
                    text: label;
                    selected: root.theme-mode == i;
                    clicked => {
                        root.theme-mode = i;
                        root.theme-chosen(i);
                    }
                }

                Rectangle {
                    height: 8px;
                }

                Text {
                    text: @tr("Week starts on");
                    font-size: 12px;
                    font-weight: 500;
                    color: Theme.text-dim;
                }

                Choice {
                    options: [@tr("Monday"), @tr("Sunday"), @tr("Saturday")];
                    current: root.week-start-choice;
                    chosen(i) => {
                        root.week-start-choice = i;
                        root.week-start-chosen(i);
                    }
                }

                Rectangle {
                    height: 8px;
                }

                Text {
                    text: @tr("Days in the custom view (X)");
                    font-size: 12px;
                    font-weight: 500;
                    color: Theme.text-dim;
                }

                Choice {
                    options: [@tr("2 days"), @tr("3 days"), @tr("4 days"), @tr("5 days"), @tr("6 days"), @tr("7 days")];
                    current: root.custom-days-choice;
                    chosen(i) => {
                        root.custom-days-choice = i;
                        root.custom-days-chosen(i);
                    }
                }

                Rectangle {
                    height: 8px;
                }

                Text {
                    text: @tr("Time format");
                    font-size: 12px;
                    font-weight: 500;
                    color: Theme.text-dim;
                }

                Choice {
                    options: [@tr("13:00"), @tr("1:00pm")];
                    current: root.clock-choice;
                    chosen(i) => {
                        root.clock-choice = i;
                        root.clock-chosen(i);
                    }
                }

                Rectangle {
                    height: 8px;
                }

                Text {
                    text: @tr("Zoom of the day columns");
                    font-size: 12px;
                    font-weight: 500;
                    color: Theme.text-dim;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    TextButton {
                        text: "−";
                        width: 36px;
                        outlined: true;
                        accessible-label: @tr("Zoom out");
                        clicked => {
                            root.zoom-by(-1);
                        }
                    }

                    Text {
                        width: 64px;
                        text: "\{Math.round(root.hour-h / 48px * 100)} %";
                        font-size: 14px;
                        color: Theme.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TextButton {
                        text: "+";
                        width: 36px;
                        outlined: true;
                        accessible-label: @tr("Zoom in");
                        clicked => {
                            root.zoom-by(1);
                        }
                    }

                    TextButton {
                        text: @tr("Reset");
                        clicked => {
                            root.set-hour-height(48px);
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    padding-top: 8px;
                    TextButton {
                        text: @tr("Close");
                        height: 32px;
                        text-color: Theme.accent;
                        clicked => {
                            root.settings-visible = false;
                        }
                    }
                }
            }
            }
        }

        // Keyboard shortcuts. Until it is closed, keys do nothing else.
        if root.help-visible: TouchArea {
            clicked => {
                root.help-visible = false;
            }
        }
        if root.help-visible: Rectangle {
            width: Math.min(380px, root.width - 24px);
            height: Math.min(shortcuts.preferred-height, root.height - 24px);
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            clip: true;
            accessible-role: groupbox;
            accessible-label: @tr("Keyboard shortcuts");

            TouchArea { }

            shortcuts := VerticalLayout {
                padding: 20px;
                spacing: 6px;

                Text {
                    text: @tr("Keyboard shortcuts");
                    font-size: 18px;
                    color: Theme.text;
                }

                Rectangle {
                    height: 6px;
                }

                for line in [
                    { keys: "t", what: @tr("Today") },
                    { keys: "j / n", what: @tr("Next period") },
                    { keys: "k / p", what: @tr("Previous period") },
                    { keys: "d / 1", what: @tr("Day view") },
                    { keys: "w / 2", what: @tr("Week view") },
                    { keys: "m / 3", what: @tr("Month view") },
                    { keys: "x / 4", what: @tr("Custom view (a few days)") },
                    { keys: "a / 5", what: @tr("Schedule view") },
                    { keys: "y / 6", what: @tr("Year view") },
                    { keys: "r", what: @tr("Refresh") },
                    { keys: "g", what: @tr("Go to a date") },
                    { keys: "c", what: @tr("Create an event") },
                    { keys: "e", what: @tr("Edit the open event") },
                    { keys: "Ctrl+S", what: @tr("Save in the editor") },
                    { keys: "s", what: @tr("Settings") },
                    { keys: "Ctrl + / −", what: @tr("Zoom the day columns (also Ctrl and the wheel)") },
                    { keys: "Ctrl+0", what: @tr("Usual zoom") },
                    { keys: "Esc", what: @tr("Close event details") },
                    { keys: "Delete", what: @tr("Delete the open event") },
                    { keys: "z", what: @tr("Undo the last change") },
                    { keys: "?", what: @tr("Show or hide this list") },
                ]: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        width: 70px;
                        text: line.keys;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text;
                    }

                    Text {
                        text: line.what;
                        font-size: 13px;
                        color: Theme.text;
                    }
                }
            }
        }
    }
}
